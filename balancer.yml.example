storage:
  type: memory                  # memory | redis
  # url: redis://localhost:6379 # required when type: redis
routing_strategy: round-robin   # round-robin | least-connections | weighted
health_endpoint: /health
health_check_interval: 10       # seconds
queue_timeout: 30               # seconds — timeout if request waits longer than this
probe_on_startup: true
force_reprobe: false            # set true to ignore cached Redis capacity and re-probe
error_threshold: 0.05           # stop probing when error rate exceeds 5%
latency_threshold_ms: 2000      # stop probing when p99 latency exceeds 2000ms

ui:
  enable: true                  # set false to disable the dashboard entirely
  path: /balancer/ui            # mount path for the dashboard
  username: admin               # optional — remove to disable UI auth
  password: secret

endpoints:
  /predict:
    method: POST
    capacity: 10                # optional — if set, skips probing and uses this value directly
    queue_timeout: 60           # optional — overrides global queue_timeout for this endpoint
    headers:
      Content-Type: application/json
      Authorization: Bearer your-token-here
    body:
      input: "sample input"

  /embed:
    method: POST
    headers:
      Content-Type: application/json
    body:
      texts: ["hello"]

  /health:
    method: GET
    capacity: 100               # lightweight endpoint, set manually
